[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    .venv,
    .teach_lab_venv,
    venv,
    node_modules,
    frontend,
    dist,
    build,
    alembic/versions,
    */alembic/versions/*
ignore =
    E203,
    W503
per-file-ignores =
    __init__.py: F401
    */conftest.py: E402
    backend/tests/conftest.py: E402
